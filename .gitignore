# Whitelist, not a blacklist: every build artifact in here is an extensionless
# binary (train_bnn_gpu, dev/adamw, ...), so a list of names would never stay
# complete. Ignore everything, then let the authored file types back in.
*
!*/
!.gitignore
!Makefile
!LICENSE
!*.c
!*.cu
!*.cuh
!*.h
!*.py
!*.md
!*.svg
!*.toml

# ...and the Python extension's build output, which is not authored either.
build/
*.egg-info/
*.so

# ...except these, which are downloaded or generated, not authored.
.venv/
data/tinyshakespeare/
__pycache__/
